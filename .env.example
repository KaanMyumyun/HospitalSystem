# Copy to .env for docker compose.
JwtSettings__SecretKey=replace-with-a-random-string-of-at-least-32-characters

# Optional: the database password compose gives PostgreSQL and the API.
# Without it compose uses strongpassword, the local-only value in the README
# and appsettings.Development.example.json. Set it before the database is
# first created (or recreate it with docker compose down -v): PostgreSQL
# keeps the password its volume was made with. Letters and digits only, as
# it goes into a connection string.
# POSTGRES_PASSWORD=
