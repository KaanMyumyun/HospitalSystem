root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_size = 4
dotnet_diagnostic.CA2016.severity = warning

[*.conf]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{HospitalSystem/Migrations/**.cs,HospitalSystem/Properties/launchSettings.json}]
charset = utf-8-bom

[*.sln]
charset = utf-8-bom
end_of_line = crlf
indent_style = tab
