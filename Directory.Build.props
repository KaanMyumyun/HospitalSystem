<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- A new warning fails the build instead of piling up unseen. NuGet
         vulnerability advisories (NU1901-NU1904) stay warnings: a newly
         published advisory should not fail an unrelated build or deploy, and
         Dependabot and the Trivy image scan already report them. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
