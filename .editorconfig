# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_size = 4

[*.conf]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# EF Core and Visual Studio generate these with a byte order mark; keep it.
[{HospitalSystem/Migrations/**.cs,HospitalSystem/Properties/launchSettings.json}]
charset = utf-8-bom

[*.sln]
charset = utf-8-bom
end_of_line = crlf
indent_style = tab
