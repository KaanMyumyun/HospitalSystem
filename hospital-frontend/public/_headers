# Response headers for Cloudflare Pages. nginx.conf sets the same ones for
# the Docker image.

# Vite puts a content hash in every file name under /assets/, so a new build
# gets new URLs and browsers can keep these files for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
